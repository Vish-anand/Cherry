# Cherry runtime configuration

# Local dashboard protection. Set this before running app.py.
CHERRY_PASSWORD=change_this_to_a_strong_local_password

# Comma-separated list of origins allowed to call the dashboard API with credentials.
# Defaults to http://localhost:8001,http://127.0.0.1:8001 if left unset. Only add other
# origins here if you deliberately want to reach the dashboard from elsewhere (e.g. a
# phone on the same LAN via its IP address).
CHERRY_ALLOWED_ORIGINS=

# Required before the WhatsApp bridge can reach the agent. Generate a random value (e.g.
# `python -c "import secrets;print(secrets.token_hex(32))"`) and set the SAME value here
# and nowhere else — whatsapp_bridge.js reads it from its own .env and sends it as the
# X-Cherry-Webhook-Secret header on every call to /api/webhook/whatsapp. Without this set,
# the webhook rejects every request.
WHATSAPP_WEBHOOK_SECRET=

# Comma-separated list of WhatsApp JIDs (e.g. 919876543210@c.us) that are allowed to reach
# the agent through WhatsApp. Every other sender's message is logged locally and silently
# dropped — no reply, no agent call. Leave empty to block all WhatsApp senders (default;
# the bridge and the webhook both warn on startup if this is empty).
WHATSAPP_ALLOWED_SENDERS=

# Workspace root. Defaults to the project directory if not overridden.
WORKSPACE_ROOT=C:\Users\Admin\Desktop\Cherry

# Preferred model provider.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional AWS Bedrock provider.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
AWS_BEDROCK_MODEL=meta.llama3-1-8b-instruct-v1:0

# Optional OpenAI/OpenRouter fallback.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=google/gemini-2.5-flash

# Optional voice service configuration.
VOICE_API_URL=
VOICE_MODEL=en-US-AnaNeural
